SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
FRONTEND_ORIGIN=http://localhost:3000
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional backend-only outbound proxy for WebNovel when the server IP is blocked.
# Example format: http://username:password@proxy-host:port
# Leave empty for direct requests. Never expose this value in the frontend.
WEBNOVEL_PROXY_URL=
