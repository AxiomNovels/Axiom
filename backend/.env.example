SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Backend only. Needed for signup, uploads, social features and administration.
SUPABASE_SECRET_KEY=
# One origin, or a comma-separated list when both a Workers URL and custom
# domain should be allowed.
FRONTEND_ORIGIN=http://localhost:3000
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional backend-only outbound proxy for WebNovel when the server IP is blocked.
# Example format: http://username:password@proxy-host:port
# Leave empty for direct requests. Never expose this value in the frontend.
WEBNOVEL_PROXY_URL=

# First-party analytics. Apply database/analytics.sql and schedule cleanup first.
ANALYTICS_ENABLED=false
# Generate a random secret; set the SAME value as a Cloudflare Worker secret.
# This is our own edge credential, NOT a Cloudflare API token. Never commit it.
ANALYTICS_EDGE_SECRET=
# Optional restricted raw IP logs, retained for seven days.
ANALYTICS_LOG_IPS=false
