SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# One origin, or a comma-separated list when both a Workers URL and custom
# domain should be allowed.
FRONTEND_ORIGIN=http://localhost:3000
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional backend-only outbound proxy for WebNovel when the server IP is blocked.
# Example format: http://username:password@proxy-host:port
# Leave empty for direct requests. Never expose this value in the frontend.
WEBNOVEL_PROXY_URL=
# Optional admin traffic analytics. Use a least-privilege Cloudflare token
# with Account > Account Analytics > Read access. Zone > Zone > Read is
# needed only to resolve the account from CLOUDFLARE_ZONE_ID instead of ACCOUNT_ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_HOSTS=axiomnovels.com,www.axiomnovels.com
# Daily Cloudflare RUM buckets use UTC.
CLOUDFLARE_ANALYTICS_TIMEZONE=UTC
